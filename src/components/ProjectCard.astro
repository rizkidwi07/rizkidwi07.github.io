---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
---
<a href={`/projects/${project.id}/`} data-category={d.category}
   class="group flex flex-col rounded-lg border border-line bg-surface transition-colors hover:border-accent">
  <div class="rounded-t-lg bg-accent-soft px-5 py-6">
    <p class="font-mono text-3xl font-semibold text-accent">{d.metric.value}</p>
    <p class="mt-1 text-sm text-muted">{d.metric.label}</p>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold">{d.title}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] text-muted">{d.summary}</p>
    <p class="mt-4 text-sm text-muted">{d.kind}, {d.period}</p>
    <p class="mt-1 font-mono text-xs text-muted">{d.stack.slice(0, 4).join(', ')}</p>
  </div>
</a>
