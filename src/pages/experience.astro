---
import Base from '../layouts/Base.astro';
import { experience, education, organizations } from '../data/experience';
---
<Base title="Experience" description="Internships, Bangkit Academy, education, and student leadership.">
  <section class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-4xl font-bold">Experience</h1>

    <ol class="mt-12 space-y-12 border-l border-line pl-8">
      {experience.map((r) => (
        <li class="relative">
          <span class={`absolute -left-[2.45rem] top-2 h-3 w-3 rounded-full border-2 border-accent ${r.highlight ? 'bg-accent' : 'bg-bg'}`} aria-hidden="true"></span>
          <h2 class="text-xl font-semibold">{r.title}</h2>
          <p class="text-muted">{r.org}, {r.type}</p>
          <p class="mt-1 font-mono text-sm text-muted">{r.period} ({r.duration})</p>
          <p class="font-mono text-sm text-muted">{r.place}</p>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            {r.bullets.map((b) => <li>{b}</li>)}
          </ul>
          {r.tools && <p class="mt-4 text-sm text-muted"><span class="font-medium text-ink">Tools:</span> {r.tools}</p>}
        </li>
      ))}
    </ol>

    <h2 class="mt-20 text-2xl font-semibold">Education</h2>
    <div class="mt-6">
      <p class="text-xl font-semibold">{education.school}</p>
      <p class="text-muted">{education.degree}</p>
      <p class="mt-1 font-mono text-sm text-muted">{education.period}</p>
      <dl class="mt-4 space-y-2">
        <div><dt class="inline font-medium">Grade: </dt><dd class="inline">{education.grade}</dd></div>
        <div><dt class="inline font-medium">Honors: </dt><dd class="inline">{education.honors}</dd></div>
        <div><dt class="inline font-medium">Thesis: </dt><dd class="inline">{education.thesis}</dd></div>
        <div><dt class="inline font-medium">Activities and societies: </dt><dd class="inline">{education.activities}</dd></div>
        <div><dt class="inline font-medium">Relevant coursework: </dt><dd class="inline">{education.coursework}</dd></div>
      </dl>
    </div>

    <h2 class="mt-20 text-2xl font-semibold">Organizations</h2>
    <ul class="mt-6 space-y-8">
      {organizations.map((o) => (
        <li>
          <p class="text-lg font-semibold">{o.title}</p>
          <p class="text-muted">{o.org}</p>
          <p class="mt-1 font-mono text-sm text-muted">{o.period}</p>
          <p class="mt-3">{o.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
