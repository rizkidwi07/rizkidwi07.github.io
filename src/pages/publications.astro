---
<Base title="Publications and certifications" description="Two journal articles and professional certifications in machine learning, MLOps, and data science.">
  <section class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-4xl font-bold">Publications</h1>
    <p class="mt-4 text-lg text-muted">Both papers come from the Peka Toksin community service project.</p>
    <ul class="mt-10 space-y-8">
      {papers.map((p) => (
        <li>
          <h2 class="text-lg font-semibold">{p.title}</h2>
          <p class="mt-1 text-muted">{p.venue}</p>
          <p class="mt-1">{p.role}. <a href={p.doi} rel="noopener" class="text-accent underline underline-offset-4">{p.doi.replace('https://', '')}</a></p>
        </li>
      ))}
    </ul>

    <h2 class="mt-20 text-3xl font-bold">Certifications and training</h2>
    <p class="mt-3 text-muted">Grouped by topic, with the most relevant first.</p>
    {groups.map((g) => (
      <div class="mt-12">
        <h3 class="text-xl font-semibold">{g.title}</h3>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {g.items.map((c) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <p class="font-medium">{c.name}</p>
                <p class="text-sm text-muted">{c.by}</p>
              </div>
              <p class="shrink-0 font-mono text-sm text-muted">{c.date}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>
