---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { diagrams } from '../../data/diagrams';
import { media } from '../../data/gallery';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2);
const m = media[entry.id] ?? { shots: [] };
const imgs = import.meta.glob('/src/assets/projects/*/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const logo = m.logo ? imgs[`/src/assets/projects/${entry.id}/${m.logo}`] : undefined;
const heroShot = m.hero ? { ...m.hero } : undefined;
const diagram = diagrams[entry.id];
if (toc.length > 0 && m.shots.length > 0) toc.push({ depth: 2, slug: 'visuals', text: 'Screenshots and visuals' });
---
<Base title={d.title} description={d.summary}>
  <article class="mx-auto max-w-5xl px-5 py-16">
    <a href="/projects/" class="text-sm text-muted hover:text-accent">All projects</a>
    <div class="mt-4 flex items-center gap-5">
      {logo && <Image src={logo} alt="" width={96} height={96} class="h-16 w-16 shrink-0 rounded-xl border border-line object-cover" />}
      <h1 class="max-w-3xl text-4xl font-bold">{d.title}</h1>
    </div>
    <p class="mt-4 max-w-2xl text-lg text-muted">{d.summary}</p>

    <dl class="mt-8 grid gap-x-10 gap-y-4 border-y border-line py-6 text-[0.95rem] sm:grid-cols-3">
      <div><dt class="text-muted">Type</dt><dd class="font-medium">{d.kind}, {d.period}</dd></div>
      <div><dt class="text-muted">Role</dt><dd class="font-medium">{d.role}</dd></div>
      <div><dt class="text-muted">Stack</dt><dd class="font-mono text-sm">{d.stack.join(', ')}</dd></div>
    </dl>

    {(d.links.github || d.links.demo || d.links.papers.length > 0) && (
      <p class="mt-6 flex flex-wrap gap-3">
        {d.links.github && <a href={d.links.github} rel="noopener" class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90">GitHub repository</a>}
        {d.links.demo && <a href={d.links.demo} rel="noopener" class="rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent">Live demo</a>}
        {d.links.papers.map((p) => <a href={p.url} rel="noopener" class="rounded-md border border-line px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent">{p.label}</a>)}
      </p>
    )}

    {heroShot && (
      <div class="mt-10">
        <Gallery id={entry.id} shots={[heroShot]} />
      </div>
    )}

    {diagram && (
      <section class="mt-14" aria-labelledby="how-it-works">
        <h2 id="how-it-works" class="text-2xl font-semibold">How it works</h2>
        <div class="mt-6 overflow-x-auto rounded-lg border border-line bg-surface p-4 sm:p-6">
          <FlowDiagram title={diagram.title} description={diagram.description} lanes={diagram.lanes} links={diagram.links} />
        </div>
        <p class="mt-2 text-sm text-muted sm:hidden">Swipe sideways to see the whole diagram.</p>
      </section>
    )}

    <div class="mt-12 grid gap-12 lg:grid-cols-[13rem_1fr]">
      <aside class="hidden lg:block">
        <nav class="sticky top-24 text-sm" aria-label="On this page">
          <ul class="space-y-2 border-l border-line">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-4 text-muted hover:border-accent hover:text-accent">{h.text}</a></li>)}
          </ul>
        </nav>
      </aside>
      <div class="min-w-0">
        <div class="case"><Content /></div>
        {m.shots.length > 0 && (
          <section id="visuals" class="mt-14">
            <h2 class="text-2xl font-semibold">Screenshots and visuals</h2>
            <div class="mt-6"><Gallery id={entry.id} shots={m.shots} /></div>
          </section>
        )}
      </div>
    </div>

    <nav class="mt-20 flex justify-between gap-6 border-t border-line pt-6 text-sm" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`} class="text-muted hover:text-accent">Previous: {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/projects/${next.id}/`} class="text-right text-muted hover:text-accent">Next: {next.data.title}</a> : <span></span>}
    </nav>
  </article>
</Base>
